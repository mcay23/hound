{
  "name": "hound-web",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.1",
    "@mui/x-date-pickers": "^6.0.4",
    "@tanstack/react-query": "^5.90.16",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.9",
    "ag-grid-react": "^34.2.0",
    "axios": "^1.1.3",
    "bootstrap": "^5.2.2",
    "dayjs": "^1.11.7",
    "electron-mpv-video": "^0.1.1",
    "electron-store": "^11.0.2",
    "mui-datatables": "^4.3.0",
    "node-addon-api": "^8.9.2",
    "planby": "^2.0.0",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-bootstrap": "^2.6.0",
    "react-dom": "^18.2.0",
    "react-horizontal-scrolling-menu": "^4.0.1",
    "react-hot-toast": "^2.4.0",
    "react-responsive-masonry": "^2.1.7",
    "uuid": "^14.0.0",
    "video.js": "^8.23.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_DEV=true electron .\"",
    "electron:preview": "npm run build && electron .",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "postinstall": "patch-package && npm --prefix node_modules/electron-mpv-video run build:native"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/mui-datatables": "^4.3.4",
    "@types/node": "^25.4.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-responsive-masonry": "^2.1.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1",
    "react-router-dom": "^6.4.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.houndmediaserver.hound",
    "productName": "Hound Desktop",
    "asar": true,
    "asarUnpack": [
      "node_modules/electron-mpv-video/**"
    ],
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
