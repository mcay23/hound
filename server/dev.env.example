SERVER_PORT=2323
APP_ENV=development
# Required. Server panics on startup if empty. Generate a unique value, e.g.:
#   openssl rand -base64 48
HOUND_SECRET=""
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hound
POSTGRES_PASSWORD=password
POSTGRES_DB=hound
# optional, since hound hard-codes a single api key for everyone
# like jellyfin and other services
# TMDB_API_KEY="your-api-key"
MDBLIST_API_KEY=""
DEBUG_LOGGING=true

# External Library
# All of these are optional
MAX_DOWNLOAD_WORKERS=3
MAX_INGEST_WORKERS=3
MAX_EXTERNAL_LIBRARY_WORKERS=2
ENABLE_EXTERNAL_LIBRARY=true
EXTERNAL_LIBRARY_SCAN_INTERVAL_MINUTES=60
# in production, this shouldn't be changed
EXTERNAL_LIBRARY_MOVIES_PATH=/app/External Library/Movies 
EXTERNAL_LIBRARY_SHOWS_PATH=/app/External Library/TV Shows
